#
# cURL Config File
#
# https://curl.se/docs/manpage.html
#

# No user-agent override: the old IE10-on-Windows-7 string was a stable cross-site
# fingerprint, and CDNs now serve degraded responses to it. curl sends an honest UA by
# default. Values here are literals -- no shell substitution -- so pin a version only
# if you must, and update it by hand.

# When following a redirect, automatically set the previous URL as referer
referer = ";auto"

# Wait 30 seconds before timing out
connect-timeout = 30

# Show error even when -s (silent) is used.
show-error

# Use the header-provided filename.
remote-header-name
